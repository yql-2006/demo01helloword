@startuml
skinparam defaultFontName "Microsoft YaHei"
start
:输入检索关键字;
:发送 HTTP 请求 /account/search;
:AccountController 接收请求;
:调用 AccountService.search(key);
:AccountService 调用 AccountDao.find(key);
:AccountDao 执行 SQL 查询;
if (查询结果为空?) then (是)
  :返回空列表;
else (否)
  :返回账户列表;
endif
:AccountService 处理结果;
:AccountController 返回 JSON 响应;
stop
@enduml